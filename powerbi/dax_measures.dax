Date =
ADDCOLUMNS(CALENDAR(MIN(orders[order_date]),MAX(orders[order_date])),
 "Year",YEAR([Date]),"Month No",MONTH([Date]),"Month",FORMAT([Date],"MMM"),
 "Year Month",FORMAT([Date],"YYYY-MM"),"Quarter","Q"&FORMAT([Date],"Q"))

Total Orders = COUNTROWS(orders)
Eligible Orders = CALCULATE(DISTINCTCOUNT(orders[order_id]),orders[order_status] IN {"Delivered","Returned"})
Returned Orders = DISTINCTCOUNT(returns[order_id])
Return Rate % = DIVIDE([Returned Orders],[Eligible Orders],0)
Open Return Cases = CALCULATE(COUNTROWS(returns),returns[is_open]=1)
Closed Return Cases = CALCULATE(COUNTROWS(returns),returns[is_open]=0)
Closed Cases Within SLA = CALCULATE(COUNTROWS(returns),returns[is_open]=0,returns[sla_met]=1)
SLA Compliance % = DIVIDE([Closed Cases Within SLA],[Closed Return Cases],0)
Total Refund Exposure = SUM(returns[refund_amount])
Average Processing Days = AVERAGE(returns[processing_days])
Open Cases Beyond SLA =
CALCULATE(COUNTROWS(returns),FILTER(returns,returns[is_open]=1 && DATEDIFF(returns[request_date],DATE(2025,12,31),DAY)>returns[sla_days]))
Average Open Case Age =
AVERAGEX(FILTER(returns,returns[is_open]=1),DATEDIFF(returns[request_date],DATE(2025,12,31),DAY))
Returns by Request Date =
CALCULATE(COUNTROWS(returns),USERELATIONSHIP('Date'[Date],returns[request_date]))

-- SLA denominator intentionally excludes open cases. Open cases beyond SLA are a separate backlog-risk measure.
-- Refund exposure is not the same as completed refund transactions.
